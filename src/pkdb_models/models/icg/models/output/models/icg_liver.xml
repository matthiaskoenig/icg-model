                <rdf:Bag>
                  <rdf:li rdf:resource="https://identifiers.org/uniprot:Q9NPD5"/>
                  <rdf:li rdf:resource="https://identifiers.org/omit:0040643"/>
                </rdf:Bag>
              </bqbiol:is>
              <bqbiol:isEncodedBy>
                <rdf:Bag>
                  <rdf:li rdf:resource="https://identifiers.org/ncit:C106617"/>
